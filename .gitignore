app/config.php
*.log

# Release zips are build output, rebuilt from the tree on every release.
# They were purged from main once already for bloating the repo — keep them out.
monsterlist-*.zip
.DS_Store
uploads/*
!uploads/.htaccess
!uploads/.gitkeep

# Recovery-tool safety gate — must never be committed or shipped
admin-reset.allow

# Output from the Toutify import scripts — a run log, not source.
toutify-link-problems.csv
toutify-listing-problems.csv

# Cached answers from Toutify's public endpoints. Regenerated on demand;
# never source, and never the same between two deployments.
storage/cache/*
!storage/cache/.htaccess
!storage/cache/.gitkeep
